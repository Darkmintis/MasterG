{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "masterg.draft/1",
  "title": "MasterG draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "product",
    "assumptions",
    "inputs",
    "coverage",
    "competitors",
    "categories",
    "findings",
    "previous_findings_review",
    "strengths",
    "metrics",
    "verdict_line",
    "calibration_note"
  ],
  "properties": {
    "schema": { "const": "masterg.draft/1" },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "platforms", "stack", "one_liner", "audience", "stage", "goal", "url", "repo"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["mobile_app", "web_app", "site", "game", "other"] },
        "platforms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "stack": { "type": "string" },
        "one_liner": { "type": "string" },
        "audience": { "type": "string" },
        "stage": { "enum": ["idea", "prototype", "beta", "live"] },
        "goal": { "enum": ["earn", "portfolio", "learning"] },
        "url": { "type": "string" },
        "repo": { "type": "string" }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "note"],
        "properties": {
          "id": { "type": "string", "pattern": "^i[0-9]+$" },
          "kind": { "enum": ["code", "screenshot", "export", "listing", "url", "text"] },
          "path": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files_reviewed", "files_total", "screenshots", "exports", "web_access", "notes"],
      "properties": {
        "files_reviewed": { "type": "integer", "minimum": 0 },
        "files_total": { "type": "integer", "minimum": 0 },
        "screenshots": { "type": "integer", "minimum": 0 },
        "exports": { "type": "integer", "minimum": 0 },
        "web_access": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "competitors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "overlap", "why_relevant", "source"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string" },
          "overlap": { "enum": ["high", "medium", "low"] },
          "why_relevant": { "type": "string" },
          "source": { "enum": ["web", "user", "model_memory"] }
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "applicable", "score", "confidence", "summary", "why", "why_not_higher", "evidence"],
        "properties": {
          "id": {
            "enum": [
              "idea",
              "differentiation",
              "revenue",
              "visual",
              "ux",
              "retention",
              "growth",
              "technical",
              "trust",
              "polish"
            ]
          },
          "applicable": { "type": "boolean" },
          "score": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 10
          },
          "confidence": { "enum": ["high", "medium", "low", "unverified"] },
          "summary": { "type": "string" },
          "why": { "type": "string" },
          "why_not_higher": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": { "$ref": "#/$defs/evidence" }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "category",
          "severity",
          "title",
          "why",
          "counterpoint",
          "evidence",
          "fix",
          "effort",
          "impact"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^(idea|differentiation|revenue|visual|ux|retention|growth|technical|trust|polish)/[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "category": {
            "enum": [
              "idea",
              "differentiation",
              "revenue",
              "visual",
              "ux",
              "retention",
              "growth",
              "technical",
              "trust",
              "polish"
            ]
          },
          "severity": { "enum": ["critical", "major", "minor", "nit"] },
          "title": { "type": "string", "minLength": 1 },
          "why": { "type": "string" },
          "counterpoint": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": { "$ref": "#/$defs/evidence" }
          },
          "fix": { "type": "string" },
          "effort": { "enum": ["S", "M", "L"] },
          "impact": { "enum": ["H", "M", "L"] }
        }
      }
    },
    "previous_findings_review": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "status", "evidence"],
        "properties": {
          "key": { "type": "string" },
          "status": { "enum": ["resolved", "persisting", "regressed"] },
          "evidence": {
            "type": "array",
            "items": { "$ref": "#/$defs/evidence" }
          }
        }
      }
    },
    "strengths": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "evidence"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/evidence" }
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "period", "source", "note"],
        "properties": {
          "name": {
            "enum": [
              "installs",
              "uninstalls",
              "dau",
              "mau",
              "retention_d1",
              "retention_d7",
              "retention_d30",
              "rating_avg",
              "rating_count",
              "crash_free_users_pct",
              "anr_rate_pct",
              "store_listing_conversion",
              "revenue",
              "ad_revenue",
              "ecpm",
              "session_length"
            ]
          },
          "value": { "type": "number" },
          "period": { "type": "string", "minLength": 1 },
          "source": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "verdict_line": { "type": "string", "minLength": 1 },
    "calibration_note": { "type": "string" }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "ref", "quote"],
      "properties": {
        "input": { "type": "string" },
        "ref": { "type": "string" },
        "quote": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
